# 复制成 /etc/shard/server.env，权限 600，属主 shard。
#
# 令牌用随机值，不要用能记住的口令：
#   openssl rand -hex 32
SHARD_AUTH_TOKEN=请替换为_openssl_rand_hex_32_的输出

# 可选：默认值见 config.rs
# SHARD_BIND=127.0.0.1:8787
# SHARD_DATA_DIR=/var/lib/shard
# SHARD_MAX_ATTACHMENT_BYTES=26214400
# RUST_LOG=shard_server=info,tower_http=info
