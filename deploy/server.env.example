# 复制成 /etc/shard/server.env（属主 root；填入模型密钥后权限设为 600，不提交到 Git）。
SHARD_ORIGIN=https://shard.example.com
RUST_LOG=info

# 自动标签：开启后后台为已有及新增的未分类公开内容补标签。
# 内容和现有主题标签会发给配置的模型服务，密匣不会发送。
SHARD_AUTO_TAG_ENABLED=false
SHARD_AUTO_TAG_API_BASE=https://api.openai.com/v1
SHARD_AUTO_TAG_MODEL=
SHARD_AUTO_TAG_API_KEY=

# 备份（shard-backup.sh 读取）
# age 公钥文件：私钥只在你自己手里（1Password + 纸质），VPS 上永远只有公钥。
SHARD_BACKUP_RECIPIENTS=/etc/shard/backup-recipients.txt
# rclone 远端（S3 / R2 / B2 / SFTP 都行），为空则只留本地快照。例如 r2:shard-backup
SHARD_BACKUP_REMOTE=
