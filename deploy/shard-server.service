[Unit]
Description=Shard sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=shard
Group=shard
ExecStart=/usr/local/bin/shard-server
Restart=always
RestartSec=2

# 令牌只从环境文件读，不进 unit 文件——unit 是所有人可读的，环境文件不是。
# 部署时：install -m 600 -o shard -g shard shard-server.env /etc/shard/server.env
EnvironmentFile=/etc/shard/server.env

# 服务只绑回环地址，公网由前面的 Caddy 终止 TLS 后反代进来。
Environment=SHARD_BIND=127.0.0.1:8787
Environment=SHARD_DATA_DIR=/var/lib/shard

# 收紧权限：这个进程需要的只有「读自己的二进制」和「读写数据目录」。
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/var/lib/shard

# SIGTERM 后服务会停止接收新连接并等在途请求结束；给足时间，
# 免得重启时把正在写库的请求硬砍掉。
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
