{
  "compilerOptions": {
    "composite": true,
    // composite 必须产出：放进 node_modules/.tmp，别在仓库根生成 vite.config.js（Vite 会优先加载它，让 .ts 的改动失效）。
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts"]
}
